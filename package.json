{
  "name": "consulting-kpi-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "bun run check-types && bun run lint && bun run test",
    "build": "tsc -b && vite build",
    "check-types": "tsc -b",
    "dev": "vite",
    "dev:all": "concurrently -k -n web,api -c cyan,magenta \"bun run dev\" \"bun run mock-api\"",
    "format": "prettier --write --cache .",
    "lint": "eslint . --ext js,jsx,ts,tsx --cache --fix",
    "mock-api": "json-server -p 4000 mock-api/db.json",
    "prepare": "husky || true",
    "preview": "vite preview",
    "test": "vitest run --cache",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@recharts/devtools": "^0.0.18",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-router-devtools": "^1.167.2",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@tanstack/router-plugin": "^1.168.40",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.1",
    "bun-types": "^1.4.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "json-server": "^1.0.0-beta.15",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sort-imports": "^1.8.11",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
